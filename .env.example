# Copy to .env for local development: cp .env.example .env
# Every setting is read from the environment; .env is loaded by the Makefile.

# dev | prod. Seeding demo data is only allowed in dev.
APP_ENV=dev
# Public base URL of the web app, used to build links in emails.
APP_URL=http://localhost:5173
HTTP_ADDR=:8080

DATABASE_URL=postgres://simdesk:simdesk@localhost:54320/simdesk?sslmode=disable

# true in production (HTTPS). Enables the Secure flag and the __Host- cookie prefix.
COOKIE_SECURE=false
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

SMTP_ADDR=localhost:1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=simdesk@localhost
MAIL_FROM_NAME=SimDesk

# Serve Swagger UI at /api/docs.
DOCS_ENABLED=true

# Where uploaded attachments are kept. Required in production: an absolute path on persistent
# disk, backed up together with the database. Development defaults to ./data/storage.
# STORAGE_DIR=/var/lib/simdesk/storage
