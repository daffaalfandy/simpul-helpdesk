{{- /* Shared copy for notification emails. HTML templates reach these through the text func. */ -}}

{{define "label.status"}}{{if eq .Status "new"}}New{{else if eq .Status "assigned"}}Assigned{{else if eq .Status "in_progress"}}In progress{{else if eq .Status "waiting_on_client"}}{{if .Portal}}Waiting on you{{else}}Waiting on client{{end}}{{else if eq .Status "in_uat"}}{{if .Portal}}Ready for your test{{else}}In UAT{{end}}{{else if eq .Status "resolved"}}Resolved{{else if eq .Status "closed"}}Closed{{else}}{{.Status}}{{end}}{{end}}

{{define "label.sla_clock"}}{{if eq . "first_response"}}first response{{else}}resolve{{end}}{{end}}

{{define "notice.headline"}}
{{- if or (eq .Event "reply") (eq .Event "comment")}}New reply
{{- else if eq .Event "internal_note"}}Internal note
{{- else if eq .Event "question"}}We're waiting for your reply
{{- else if eq .Event "new_ticket"}}New ticket
{{- else if eq .Event "resolved"}}{{if eq .StatusTo "closed"}}Closed{{else}}Resolved{{end}}
{{- else if eq .Event "status"}}{{if and .Portal (eq .StatusTo "in_uat")}}Ready for your test{{else}}Status changed{{end}}
{{- else if eq .Event "assignment"}}{{if eq .Kind "unassigned"}}Unassigned{{else}}Assigned to you{{end}}
{{- else if eq .Event "priority"}}Priority changed
{{- else if eq .Event "colleague"}}{{if eq .Kind "added"}}You were added{{else}}Update from a colleague{{end}}
{{- else if eq .Event "ticket_logged"}}We logged your request
{{- else if eq .Event "sla"}}{{if eq .Kind "breached"}}SLA breached{{else}}SLA at risk{{end}}
{{- else if eq .Event "uat_requested"}}Ready for your test
{{- else if eq .Event "uat_result"}}{{if eq .Kind "rejected"}}UAT rejected{{else if eq .Kind "auto_approved"}}UAT approved automatically{{else}}UAT approved{{end}}
{{- else if eq .Event "dod"}}{{if eq .Kind "override"}}Definition of Done changed{{else}}Resolved without its Definition of Done{{end}}
{{- else if eq .Event "code"}}Code activity
{{- else}}Ticket updated{{end}}
{{- end}}

{{define "notice.actor"}}{{if .ActorName}}{{.ActorName}}{{else}}The helpdesk{{end}}{{end}}

{{define "notice.summary"}}
{{- if or (eq .Event "reply") (eq .Event "comment")}}{{template "notice.actor" .}} replied
{{- else if eq .Event "internal_note"}}{{template "notice.actor" .}} added an internal note
{{- else if eq .Event "question"}}{{template "notice.actor" .}} needs your reply or confirmation to continue
{{- else if eq .Event "new_ticket"}}{{template "notice.actor" .}} opened this ticket; nobody is assigned yet
{{- else if or (eq .Event "status") (eq .Event "resolved")}}Status changed: {{status .StatusFrom .Portal}} → {{status .StatusTo .Portal}}
{{- else if eq .Event "assignment"}}{{if eq .Kind "unassigned"}}{{template "notice.actor" .}} unassigned you from this ticket{{else}}{{template "notice.actor" .}} assigned this ticket to you{{end}}
{{- else if eq .Event "priority"}}{{template "notice.actor" .}} changed priority: {{.PriorityFrom}} → {{.PriorityTo}}{{if .Reason}} ({{.Reason}}){{end}}
{{- else if eq .Event "colleague"}}{{if eq .Kind "added"}}{{template "notice.actor" .}} added you to this ticket{{else if eq .Kind "status"}}{{template "notice.actor" .}} changed the status: {{status .StatusFrom .Portal}} → {{status .StatusTo .Portal}}{{else}}{{template "notice.actor" .}} replied{{end}}
{{- else if eq .Event "ticket_logged"}}{{template "notice.actor" .}} logged this request for you
{{- else if eq .Event "sla"}}{{if eq .Kind "breached"}}SLA breached: {{template "label.sla_clock" .SLAClock}} was due at {{.SLADue}}{{else}}SLA at risk: {{template "label.sla_clock" .SLAClock}} due in {{with .SLAMinutesLeft}}{{.}}{{end}} min{{end}}
{{- else if eq .Event "uat_requested"}}{{template "notice.actor" .}} asked you to test the fix
{{- else if eq .Event "uat_result"}}{{if eq .Kind "rejected"}}{{template "notice.actor" .}} sent the fix back{{else if eq .Kind "auto_approved"}}Nobody answered the test in time, so the fix was approved automatically{{else}}{{template "notice.actor" .}} approved the fix{{end}}
{{- else if eq .Event "dod"}}{{if eq .Kind "override"}}{{template "notice.actor" .}} set a Definition of Done for this ticket{{else}}{{template "notice.actor" .}} resolved this ticket without meeting its Definition of Done{{end}}{{if .Reason}} ({{.Reason}}){{end}}
{{- else if and (eq .Event "code") .Code}}{{template "code.summary" .Code}}
{{- end}}
{{- end}}

{{define "code.provider"}}{{if eq . "gitlab"}}GitLab{{else}}GitHub{{end}}{{end}}

{{define "code.request"}}{{if eq .Provider "gitlab"}}MR !{{.Ref}}{{else}}PR #{{.Ref}}{{end}}{{end}}

{{- /* Requests, CI runs and deployments appear only in notifications from before 17 Nov. */ -}}
{{define "code.summary"}}{{template "code.provider" .Provider}}: 
{{- if eq .Kind "commit"}} commit {{.Ref}} on {{.Branch}} mentions this ticket
{{- else if eq .Kind "pr_opened"}} {{template "code.request" .}} opened → {{.Target}}
{{- else if eq .Kind "pr_merged"}} {{template "code.request" .}} merged into {{.Target}}
{{- else if eq .Kind "pr_closed"}} {{template "code.request" .}} closed without merging
{{- else if eq .Kind "pipeline"}} CI passed on {{.Branch}}
{{- else if eq .Kind "deployment"}} deployed to {{.Ref}}
{{- end}}{{end}}

{{define "change.summary"}}
{{- if eq .Change "status"}}Status changed: {{status .StatusFrom .Portal}} → {{status .StatusTo .Portal}}
{{- else if eq .Change "priority"}}Priority changed: {{.PriorityFrom}} → {{.PriorityTo}}
{{- else if eq .Change "assignee"}}{{if .Assignee}}Assigned to {{.Assignee}}{{else}}Unassigned{{end}}
{{- else if eq .Change "message"}}New message
{{- else if eq .Change "watcher_added"}}A colleague was added
{{- else if eq .Change "code"}}Code activity
{{- else}}Ticket updated{{end}}
{{- end}}

{{define "relation.reason"}}
{{- if eq .Relation "reported"}}You're getting this because you reported {{.TicketKey}}.
{{- else if eq .Relation "logged"}}You're getting this because {{.TicketKey}} was logged for you.
{{- else if eq .Relation "watching"}}You're getting this because a colleague added you to {{.TicketKey}}.
{{- else if eq .Relation "assigned"}}You're getting this because you're assigned to {{.TicketKey}}.
{{- else if eq .Relation "supervisor"}}You're getting this because you supervise SLA alerts.
{{- else if eq .Relation "supervisor_dod"}}You're getting this because supervisors hear when a Definition of Done is skipped or changed.
{{- else if eq .Relation "supervisor_unassigned"}}You're getting this because supervisors hear about tickets nobody is assigned to.
{{- else}}You're getting this because you worked on {{.TicketKey}}.{{end}}
{{- end}}

{{define "question.fallback"}}Open the ticket to see what the team needs from you.{{end}}

{{define "question.reply"}}Reply now{{end}}

{{define "ticket.view"}}View the ticket{{end}}

{{define "uat.question"}}Does it work now?{{end}}

{{define "uat.approve"}}Approve, it works{{end}}

{{define "uat.reject"}}Still a problem{{end}}

{{define "uat.auto"}}If we don't hear back, the fix is approved automatically on {{.}}.{{end}}

{{define "reopen.line"}}You can reopen this ticket until {{.}} if the problem comes back.{{end}}

{{define "footer.reply"}}{{if .}}Reply in the portal; replies to this email aren't read.{{else}}Reply in SimDesk; replies to this email aren't read.{{end}}{{end}}

{{define "digest.title"}}{{if .Daily}}Your daily summary{{else}}Your hourly summary{{end}}{{end}}

{{define "digest.count"}}{{.Count}} {{if eq .Count 1}}update{{else}}updates{{end}} on {{len .Tickets}} {{if eq (len .Tickets) 1}}ticket{{else}}tickets{{end}}{{end}}

{{define "label.duration"}}{{.TargetValue}} {{if eq .TargetUnit "min"}}{{if eq .TargetValue 1}}minute{{else}}minutes{{end}}{{else if eq .TargetUnit "h"}}{{if eq .TargetValue 1}}hour{{else}}hours{{end}}{{else if eq .TargetUnit "wd"}}{{if eq .TargetValue 1}}working day{{else}}working days{{end}}{{else}}{{if eq .TargetValue 1}}day{{else}}days{{end}}{{end}}{{end}}

{{define "sla.line"}}{{if .Request}}Delivery target{{else}}Fix target{{end}}: {{template "label.duration" .}}{{if and .PauseWaiting .PauseUAT}} · time waiting for your reply or test doesn't count{{else if .PauseWaiting}} · time waiting for your reply doesn't count{{else if .PauseUAT}} · time waiting for your test doesn't count{{end}}{{end}}
